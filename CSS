body {
  font-family: Arial;
  background: #fef6f0;
  margin: 0;
}

header {
  background: #ff8c42;
  color: white;
  padding: 1rem;
  text-align: center;
  position: relative;
}

#userBar {
  position: absolute;
  top: 10px;
  right: 10px;
}

.hidden { display: none; }

input, textarea {
  display: block;
  margin: 10px;
  padding: 8px;
  width: 80%;
}

button {
  margin: 5px;
  padding: 8px;
}

.post {
  background: white;
  margin: 10px;
  padding: 10px;
  border-radius: 10px;
}
